<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="Login suite">
    <test name="Both correct">
        <parameter name="username" value="Admin"/>
        <parameter name="password" value="admin123"/>
        <parameter name="validation" value="valid"/>
        <classes>
            <class name="DataDrivenTest.LoginUsingParameters"/>
        </classes>
    </test>

    <test name="Both Incorrect">
        <parameter name="username" value="WrongAdmin"/>
        <parameter name="password" value="Wrongadmin123"/>
        <parameter name="validation" value="invalid"/>
        <classes>
            <class name="DataDrivenTest.LoginUsingParameters"/>
        </classes>
    </test>

    <test name="Correct password">
        <parameter name="username" value="WrongAdmin"/>
        <parameter name="password" value="admin123"/>
        <parameter name="validation" value="invalid"/>
        <classes>
            <class name="DataDrivenTest.LoginUsingParameters"/>
        </classes>
    </test>

    <test name="Correct Username">
        <parameter name="username" value="Admin"/>
        <parameter name="password" value="Wrongadmin123"/>
        <parameter name="validation" value="invalid"/>
        <classes>
            <class name="DataDrivenTest.LoginUsingParameters"/>
        </classes>
    </test>
</suite>